{
    "manifest-version": 3,
    "name": "capell-app/widget-hotspots",
    "slug": "widget-hotspots",
    "displayName": "Hotspots Widget",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "preview",
    "description": "Numbered points on one uploaded image that visitors tap to read a short label and detail about each part.",
    "product": {
        "group": "Capell Essentials",
        "tier": "free",
        "bundle": "foundation"
    },
    "namespace": "Capell\\WidgetHotspots",
    "surfaces": ["admin", "frontend"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/frontend",
            "capell-app/layout-builder"
        ],
        "supports": [],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\WidgetHotspots\\Providers\\WidgetHotspotsServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "content-widget",
            "key": "capell-app.hotspots",
            "class": "Capell\\WidgetHotspots\\WidgetHotspotsContribution"
        },
        {
            "type": "asset",
            "key": "resource-group:capell-app.widget-hotspots",
            "class": "Capell\\WidgetHotspots\\WidgetHotspotsContribution"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "setupParams": [],
        "demo": null,
        "doctor": null
    },
    "settings": [],
    "permissions": [],
    "capabilities": ["frontend-surface"],
    "security": {
        "riskTier": "low",
        "publicSurface": {
            "routeNames": [],
            "auth": "none",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": []
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": false,
            "requiresSecretRedaction": false,
            "clients": []
        },
        "adminSurface": {
            "authorization": "panel-auth",
            "permissions": []
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 10,
        "adminQueryBudget": 0,
        "cacheTags": ["widget-hotspots"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale", "theme"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                },
                {
                    "model": "Capell\\Core\\Models\\Media",
                    "events": [
                        "created",
                        "updated",
                        "deleted",
                        "restored",
                        "forceDeleted"
                    ]
                }
            ],
            "queueInvalidation": false
        }
    },
    "healthChecks": [
        {
            "key": "widget-hotspots.package-health",
            "label": "Hotspots widget package health",
            "class": "Capell\\WidgetHotspots\\Health\\WidgetHotspotsHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "capell-first-party",
        "privateDocsRequested": false
    },
    "marketplace": {
        "summary": "Explain a product photo, floor plan or diagram with up to thirty numbered points visitors can open.",
        "description": "Upload a product photo or floor plan and add up to thirty numbered dots to it. Drag each dot into place on a preview, or nudge it with the arrow keys. Every dot has a short label and a few lines of plain text that open when a visitor taps it. A note can also link to another part of the same page, such as a size guide. Dots are sized for thumbs, take your theme's main colour and can be reached with the keyboard. The image must be uploaded to the Capell media library. It needs Layout Builder to place it on a page.",
        "problem": "People look at a detailed picture and can't tell what each part is or why it matters.",
        "outcome": "Visitors tap a numbered dot and read a short explanation of that exact spot.",
        "faq": [
            {
                "question": "What can a dot show?",
                "answer": "A short label and a few lines of plain text. A dot can also link to other content you have put on the same page, such as a size guide, but not to a different page."
            },
            {
                "question": "How many dots can one image have?",
                "answer": "Up to thirty."
            },
            {
                "question": "Can I use an image from another website?",
                "answer": "No. The image has to be one you have uploaded to your site, and it needs a description for screen readers."
            },
            {
                "question": "How do I place a dot exactly?",
                "answer": "Drag it to the right spot on the image preview. For fine adjustments, move it with the arrow keys."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/listing-hotspots-public-output.png",
                "alt": "Photo of a glass-walled office corridor with two numbered round markers placed over it",
                "caption": "Visitors see numbered dots on the photo and tap one to read about that spot."
            },
            {
                "path": "docs/assets/marketplace/listing-hotspots-layout-builder-editor.png",
                "alt": "Page editor with an Image hotspots block open, showing the photo, its alt text and the first hotspot's label and detail",
                "caption": "The image, its description and each dot's label and detail are filled in here."
            },
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Marketplace card for Hotspots with three numbered dots over a mountain drawing and a line about keyboard-reachable detail",
                "caption": "Card used for the widget's Marketplace listing."
            }
        ],
        "categories": ["foundation", "frontend", "interactive"]
    },
    "contributionTraceability": {
        "contributions": [
            {
                "type": "asset",
                "key": "resource-group:capell-app.widget-hotspots",
                "providerBucket": "runtime"
            },
            {
                "type": "content-widget",
                "key": "capell-app.hotspots",
                "providerBucket": "runtime"
            }
        ]
    }
}
